# Copy to .env.local for the web app or .env for Docker.
# Do not put secret values in NEXT_PUBLIC_ variables.

# PostgreSQL (docker compose default)
DATABASE_URL=postgresql://solarforge:solarforge@localhost:5432/solarforge

# Optional Redis for shared rate limits. In-memory limits are used when unset.
REDIS_URL=redis://localhost:6379

# Signs the session cookie. Use a long random string in production.
AUTH_SECRET=replace-with-a-long-random-string

# Public site URL, no trailing slash. Used for canonical links and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional contact address shown on the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=planning@example.com

# NREL PVWatts. When unset, production uses the labeled approximate climate model.
# Request a key at https://developer.nrel.gov/signup/
NREL_API_KEY=

# OpenAI. When unset, the assistant uses the on-device calculation explainer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe. When unset, checkout explains that billing is not configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PROFESSIONAL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# RevenueCat (mobile). When unset, the app does not offer store purchases.
EXPO_PUBLIC_REVENUECAT_API_KEY=
