{
  "name": "solarforge",
  "private": true,
  "version": "0.1.0",
  "description": "SolarForge solar planning monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @solarforge/web",
    "dev:mobile": "npm run start -w @solarforge/mobile",
    "test": "npm run test -w @solarforge/engine",
    "typecheck": "npm run typecheck -w @solarforge/engine && npm run typecheck -w @solarforge/shared && npm run typecheck -w @solarforge/web",
    "build": "npm run build -w @solarforge/web",
    "db:generate": "npm run db:generate -w @solarforge/web",
    "db:migrate": "npm run db:migrate -w @solarforge/web"
  },
  "engines": {
    "node": ">=20"
  }
}
